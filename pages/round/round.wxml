<!--pages/round/round.wxml —— 计分局核心页-->
<!-- theme-root 承载手动主题偏好类名（theme-light / theme-dark），空类名时跟随系统 -->
<view class="theme-root {{themeClass}}">
<custom-nav title="计分局" back="true" />
<view class="page" style="padding-top: {{navPad}}px;">

  <!-- 顶栏：模式标签 + 撤销 + 结束 -->
  <view class="topbar flex aic jcb">
    <view class="mode-tag">{{modeName}}</view>
    <view class="flex aic topbar-actions">
      <view wx:if="{{!strictHidden}}" class="chip-btn {{strictOn ? 'chip-strict-on' : ''}} {{strictFixed ? 'chip-fixed' : ''}}" hover-class="press-hover" hover-stay-time="80" bindtap="onToggleStrict">{{strictChipText}}</view>
      <view class="chip-btn {{canUndo ? '' : 'chip-disabled'}}" hover-class="press-hover" hover-stay-time="80" bindtap="onUndo">撤销</view>
      <view class="chip-btn chip-danger" hover-class="press-hover" hover-stay-time="80" bindtap="onFinish">结束对局</view>
    </view>
  </view>

  <!-- 战况仪表盘：实时排名条（掼蛋 v2 换用下方队伍战况面板） -->
  <scroll-view wx:if="{{ranking.length && inputKind !== 'guandan'}}" scroll-x class="rank-bar" enhanced show-scrollbar="{{false}}">
    <view class="rank-inner">
      <view
        wx:for="{{ranking}}"
        wx:key="playerId"
        class="rank-item {{item.isBig ? 'rank-big' : ''}}"
      >
        <view class="avatar" style="background: {{item.color}}">{{item.short}}</view>
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-total">{{item.totalText}}</view>
        <view wx:if="{{item.isBig}}" class="big-badge">{{winnerLabel}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 掼蛋 v2 队伍战况：两队实时打几与打A失败计数 -->
  <view wx:if="{{gdBoard}}" class="gd-board flex">
    <view wx:for="{{gdBoard}}" wx:key="label" class="gd-team {{item.isWin ? 'gd-win' : ''}}">
      <view class="flex aic jcb">
        <text class="gd-label">{{item.label}}</text>
        <text wx:if="{{item.isWin}}" class="gd-win-tag">过A · 终局</text>
      </view>
      <view class="gd-level">{{item.levelText}}</view>
      <view class="gd-members">
        <view wx:for="{{item.members}}" wx:for-item="m" wx:key="name" class="gd-member flex aic">
          <view class="dot" style="background: {{m.color}}"></view>
          <text>{{m.name}}</text>
        </view>
      </view>
      <view wx:if="{{item.failsText}}" class="gd-fails">{{item.failsText}}</view>
    </view>
  </view>

  <!-- 目标类模式进度：降序显示目标分/领先，升序（asc）接线 targetLabel 显示罚分上限/逼近文案 -->
  <view wx:if="{{targetInfo}}" class="card target-progress">
    <view class="flex aic jcb">
      <text wx:if="{{ascending}}" class="muted">{{targetInfo.targetLabel}} {{targetInfo.target}} 分</text>
      <text wx:else class="muted">目标 {{targetInfo.target}} 分</text>
      <text wx:if="{{ascending}}" class="target-leader">{{targetInfo.leaderName}} 已累 {{targetInfo.leaderTotal}} 分 · 逼近上限</text>
      <text wx:else class="target-leader">领先 {{targetInfo.leaderName}} {{targetInfo.leaderTotal}} 分</text>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width: {{targetInfo.percent}}%"></view>
    </view>
  </view>

  <!-- 输入区：按模式 fields 动态渲染 -->
  <view class="card input-card">

    <!-- 掼蛋 v2：选择式录入（头游 + 队友名次），无数字键盘 -->
    <block wx:if="{{inputKind === 'guandan'}}">
      <view class="ctrl-title">头游（最先出完牌）</view>
      <view class="flex wrap chip-row">
        <view
          wx:for="{{playerList}}"
          wx:key="id"
          class="pick-chip {{gdHeadIndex === index ? 'pick-on' : ''}}"
          data-index="{{index}}"
          hover-class="press-hover"
          hover-stay-time="80"
          bindtap="onPickGdHead"
        >
          <view class="dot" style="background: {{item.color}}"></view>
          <text>{{item.name}}</text>
          <text class="gd-chip-team">{{item.teamLabel}}</text>
        </view>
      </view>

      <view class="ctrl-title">头游队友的名次</view>
      <view class="seg flex">
        <view
          wx:for="{{gdFinishes}}"
          wx:key="key"
          class="seg-item {{gdFinish === item.key ? 'seg-on-gd' : ''}}"
          data-key="{{item.key}}"
          hover-class="press-hover"
          hover-stay-time="80"
          bindtap="onPickGdFinish"
        >{{item.label}}</view>
      </view>

      <view class="faint gd-rule-hint">双上升3级 · 头游+三游升2级 · 头游+末游升1级；打A时队友非末游即过A，三次不过回到2</view>
    </block>

    <!-- 其余模式：数值槽位 -->
    <view wx:if="{{inputKind !== 'guandan'}}" class="slot-grid">
      <view
        wx:for="{{slots}}"
        wx:key="label"
        class="slot {{focusIndex === index ? 'slot-focus' : ''}}"
        data-index="{{index}}"
        bindtap="onSlotTap"
      >
        <view class="slot-label flex aic">
          <view wx:if="{{item.color}}" class="dot" style="background: {{item.color}}"></view>
          <text>{{item.label}}</text>
        </view>
        <view class="slot-value {{values[index] ? '' : 'slot-empty'}}">{{values[index] || '0'}}</view>
      </view>

      <!-- 零和局末位自动补全 -->
      <view wx:if="{{autoSlot}}" class="slot slot-auto">
        <view class="slot-label flex aic">
          <view class="dot" style="background: {{autoSlot.color}}"></view>
          <text>{{autoSlot.name}} · 自动补全</text>
        </view>
        <view class="slot-value">{{autoSlot.valueText || '—'}}</view>
      </view>
    </view>

    <!-- 斗地主控件 -->
    <block wx:if="{{inputKind === 'landlord'}}">
      <view class="ctrl-title">选择地主</view>
      <view class="flex wrap chip-row">
        <view
          wx:for="{{playerList}}"
          wx:key="id"
          class="pick-chip {{landlordIndex === index ? 'pick-on' : ''}}"
          data-index="{{index}}"
          hover-class="press-hover"
          hover-stay-time="80"
          bindtap="onPickLandlord"
        >
          <view class="dot" style="background: {{item.color}}"></view>
          <text>{{item.name}}</text>
        </view>
      </view>

      <view class="ctrl-title">地主胜负</view>
      <view class="seg flex">
        <view class="seg-item {{landlordWin ? 'seg-on-win' : ''}}" data-win="win" hover-class="press-hover" hover-stay-time="80" bindtap="onSetWin">地主胜</view>
        <view class="seg-item {{!landlordWin ? 'seg-on-lose' : ''}}" data-win="lose" hover-class="press-hover" hover-stay-time="80" bindtap="onSetWin">地主败</view>
      </view>

      <view class="ctrl-title">倍数事件 · 各 ×2 连乘</view>
      <view class="flex wrap chip-row">
        <view class="mul-chip {{bombOn ? 'mul-on' : ''}}" data-key="bombOn" hover-class="press-hover" hover-stay-time="80" bindtap="onToggleMul">炸弹 ×2</view>
        <view class="mul-chip {{rocketOn ? 'mul-on' : ''}}" data-key="rocketOn" hover-class="press-hover" hover-stay-time="80" bindtap="onToggleMul">火箭 ×2</view>
        <view class="mul-chip {{springOn ? 'mul-on' : ''}}" data-key="springOn" hover-class="press-hover" hover-stay-time="80" bindtap="onToggleMul">春天 ×2</view>
      </view>
    </block>

    <!-- 当前校验状态（小字提示，位于键盘区上方） -->
    <view wx:if="{{strictHintText}}" class="faint strict-hint">{{strictHintText}}</view>

    <!-- 自绘数字键盘（掼蛋 v2 纯选择式录入，不展示） -->
    <view wx:if="{{inputKind !== 'guandan'}}" class="keypad">
      <view wx:for="{{keypadRows}}" wx:key="id" wx:for-item="row" class="key-row">
        <view
          wx:for="{{row.keys}}"
          wx:for-item="key"
          wx:key="k"
          class="key {{key.wide ? 'key-wide' : ''}} {{key.k === 'sign' && !focusSigned ? 'key-off' : ''}} {{key.k === 'del' || key.k === 'clear' ? 'key-fn' : ''}}"
          data-k="{{key.k}}"
          hover-class="press-hover"
          hover-stay-time="80"
          bindtap="onKey"
        >{{key.label}}</view>
      </view>
    </view>

    <button class="btn btn-primary submit-btn" hover-class="press-hover" hover-stay-time="80" bindtap="onSubmit">记一轮</button>
  </view>

  <!-- 回合流水（左滑废弃：外壳裁剪，内层 round-body 平移露出右侧废弃按钮） -->
  <view class="section-title">回合流水</view>
  <block wx:if="{{hasRounds}}">
    <view
      wx:for="{{roundRows}}"
      wx:key="id"
      class="round-row {{item.voided ? 'round-void' : ''}}"
    >
      <view class="round-void-btn" catchtap="onVoidTap" data-id="{{item.id}}">废弃</view>
      <view
        class="round-body {{item.swipeAnim ? 'round-anim' : ''}}"
        style="transform: translateX({{item.tx || 0}}px)"
        data-index="{{index}}"
        bindtouchstart="onRowTouchStart"
        bindtouchmove="onRowTouchMove"
        bindtouchend="onRowTouchEnd"
        bindtouchcancel="onRowTouchEnd"
      >
        <view class="flex aic jcb round-head">
          <view class="flex aic">
            <text class="round-seq">#{{item.seq}}</text>
            <text wx:if="{{item.voided}}" class="void-tag">已废弃</text>
          </view>
          <text class="faint">{{item.timeText}}</text>
        </view>
        <view class="flex wrap round-cells">
          <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="name" class="cell flex aic">
            <view class="dot" style="background: {{cell.color}}"></view>
            <text class="cell-name">{{cell.name}}</text>
            <text class="cell-delta {{cell.cls}}">{{cell.text}}</text>
          </view>
        </view>
        <view wx:if="{{item.note}}" class="round-note">{{item.note}}</view>
      </view>
    </view>
    <view class="faint list-tip">左滑回合可将其废弃</view>
  </block>
  <view wx:else class="empty">还没有回合，落下第一牌吧</view>

  <!-- 终局结算面板 -->
  <view wx:if="{{showSettle}}" class="mask">
    <view class="settle-panel">
      <view class="settle-kicker">GAME OVER</view>
      <view class="settle-title">终局结算</view>
      <view wx:if="{{finalWinnerName}}" class="settle-winner flex aic jcc">
        <view class="avatar" style="background: {{finalWinnerColor}}">{{finalWinnerShort}}</view>
        <view>
          <view class="faint winner-label">{{winnerLabel}}</view>
          <view class="winner-name">{{finalWinnerName}}</view>
        </view>
      </view>
      <view class="settle-list">
        <view wx:for="{{finalRanking}}" wx:key="playerId" class="settle-row flex aic jcb">
          <view class="flex aic">
            <text class="settle-rank">{{item.rank}}</text>
            <view class="avatar avatar-sm" style="background: {{item.color}}">{{item.short}}</view>
            <text>{{item.name}}</text>
          </view>
          <text class="settle-total">{{item.totalText}} 分</text>
        </view>
      </view>
      <view class="flex settle-actions">
        <button class="btn btn-ghost grow" hover-class="press-hover" hover-stay-time="80" bindtap="onSettleContinue">继续记录</button>
        <button class="btn btn-primary grow" hover-class="press-hover" hover-stay-time="80" bindtap="onSettleArchive">归档战绩</button>
      </view>
    </view>
  </view>

</view>
</view>
